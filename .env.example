# Run ./scripts/Initialize.ps1 to create .env with random local secrets.
POSTGRES_DB=whatsapp_crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-with-random-secret
DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
REDIS_PASSWORD=replace-with-random-secret
WPPCONNECT_SECRET_KEY=replace-with-random-secret
WPPCONNECT_WEBHOOK_SECRET=replace-with-random-secret
WPPCONNECT_ENABLED=false
VITE_SHOW_WHATSAPP_UI=true
VITE_SHOW_WEBSITE_CHAT_UI=true
CRM_AI_API_KEY=
CRM_AI_MODEL=
BACKEND_PORT=8000
FRONTEND_PORT=5173
# If changing frontend/backend ports, also update the trusted origins below.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

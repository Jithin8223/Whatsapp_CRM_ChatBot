# Production image: static Vite build served by nginx, which also reverse-proxies the
# API and WebSockets to Daphne. Local development keeps using ./Dockerfile (Vite dev server).
FROM node:22.22.2-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_SHOW_WHATSAPP_UI=true
ARG VITE_SHOW_WEBSITE_CHAT_UI=true
ENV VITE_SHOW_WHATSAPP_UI=$VITE_SHOW_WHATSAPP_UI VITE_SHOW_WEBSITE_CHAT_UI=$VITE_SHOW_WEBSITE_CHAT_UI
RUN npm test && npm run build

FROM nginx:1.28.0-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/relay.conf /etc/nginx/conf.d/default.conf
COPY nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -qO- http://127.0.0.1:8080/nginx-health || exit 1
